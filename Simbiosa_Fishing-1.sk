# ========================================
# SIMBIOSA FISHING SYSTEM - SEASON 1
# Separate from Simbiosa_ToolSkins.sk and Simbiosa_Welcome.sk
# Skript-only starter: admin give commands and item IDs.
# ========================================

options:
    prefix: &8[&bSimbiosa Fishing&8] &7

command /sfish [<text>] [<player>] [<text>]:
    permission: simbiosa.fishing.admin
    permission message: {@prefix}&cKamu tidak punya permission.
    trigger:
        if arg-1 is not set:
            send "&8&m--------------------------------"
            send "&b&lSIMBIOSA FISHING S1"
            send "&7/sfish list"
            send "&7/sfish give <player> <fish_id>"
            send "&7/sfish reload"
            send "&8&m--------------------------------"
            stop
        if arg-1 is "list":
            send "&b&lSIMBIOSA FISHING S1 &7— 30 FISH"
            send "&fCOMMON: &7River Carp, Silver Salmon, Blue Minnow, Red Guppy, Yellow Perch"
            send "&fUNCOMMON: &7Emerald Koi, Golden Tilapia, Striped Bass, Spotted Puffer, Azure Tetra"
            send "&fRARE: &7Sapphire Fish, Crimson Koi, Violet Angelfish, Golden Arowana, Shadow Eel"
            send "&fEPIC: &7Crystal Koi, Phantom Jellyfish, Emberfin, Frostscale Fish, Stormray"
            send "&fLEGENDARY: &7Celestial Koi, Phoenix Salmon, Moonlight Ray, Abyssal Leviathan, Golden Dragonfish"
            send "&fMYTHIC: &7Astral Whale, Void Serpent, Eternal Phoenix Fish, Divine Leviathan, Genesis Fish"
            send "&7Contoh ID: &fSIM_FISH_COMMON_01"
            stop
        if arg-1 is "reload":
            send "{@prefix}&aGunakan &f/sk reload Simbiosa_Fishing.sk &auntuk reload."
            stop
        if arg-1 is "give":
            if arg-2 is not set or arg-3 is not set:
                send "{@prefix}&cFormat: /sfish give <player> <fish_id>"
                stop
            if arg-3 is "SIM_FISH_COMMON_01":
                set {_x} to cod
                set name of {_x} to "&fRiver Carp"
                set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_FISH_COMMON_01"
                set custom model data of {_x} to 51001
                give {_x} to arg-2
                send "{@prefix}&aRiver Carp &7diberikan kepada &f%arg-2%&7."
                stop
            if arg-3 is "SIM_FISH_COMMON_02":
                set {_x} to cod
                set name of {_x} to "&fSilver Salmon"
                set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_FISH_COMMON_02"
                set custom model data of {_x} to 51002
                give {_x} to arg-2
                send "{@prefix}&aSilver Salmon &7diberikan kepada &f%arg-2%&7."
                stop
            if arg-3 is "SIM_FISH_COMMON_03":
                set {_x} to cod
                set name of {_x} to "&fBlue Minnow"
                set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_FISH_COMMON_03"
                set custom model data of {_x} to 51003
                give {_x} to arg-2
                send "{@prefix}&aBlue Minnow &7diberikan kepada &f%arg-2%&7."
                stop
            if arg-3 is "SIM_FISH_COMMON_04":
                set {_x} to cod
                set name of {_x} to "&fRed Guppy"
                set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_FISH_COMMON_04"
                set custom model data of {_x} to 51004
                give {_x} to arg-2
                send "{@prefix}&aRed Guppy &7diberikan kepada &f%arg-2%&7."
                stop
            if arg-3 is "SIM_FISH_COMMON_05":
                set {_x} to cod
                set name of {_x} to "&fYellow Perch"
                set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_FISH_COMMON_05"
                set custom model data of {_x} to 51005
                give {_x} to arg-2
                send "{@prefix}&aYellow Perch &7diberikan kepada &f%arg-2%&7."
                stop
            if arg-3 is "SIM_FISH_UNCOMMON_01":
                set {_x} to cod
                set name of {_x} to "&fEmerald Koi"
                set lore of {_x} to "&7Rarity: &fUNCOMMON", "&8ID: SIM_FISH_UNCOMMON_01"
                set custom model data of {_x} to 51006
