command /srod [<text>] [<player>] [<text>]:
    permission: simbiosa.fishing.admin
    permission message: {@prefix}&cKamu tidak punya permission.
    trigger:
        if arg-1 is not "give":
            send "{@prefix}&7Format: /srod give <player> <rod_id>"
            stop
        if arg-2 is not set or arg-3 is not set:
            send "{@prefix}&7Format: /srod give <player> <rod_id>"
            stop
        if arg-3 is "SIM_ROD_01":
            set {_x} to fishing rod
            set name of {_x} to "&bWooden Rod"
            set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_ROD_01"
            set custom model data of {_x} to 51101
            give {_x} to arg-2
            send "{@prefix}&aWooden Rod &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_ROD_02":
            set {_x} to fishing rod
            set name of {_x} to "&bReinforced Rod"
            set lore of {_x} to "&7Rarity: &fUNCOMMON", "&8ID: SIM_ROD_02"
            set custom model data of {_x} to 51102
            give {_x} to arg-2
            send "{@prefix}&aReinforced Rod &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_ROD_03":
            set {_x} to fishing rod
            set name of {_x} to "&bAngler Rod"
            set lore of {_x} to "&7Rarity: &fRARE", "&8ID: SIM_ROD_03"
            set custom model data of {_x} to 51103
            give {_x} to arg-2
            send "{@prefix}&aAngler Rod &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_ROD_04":
            set {_x} to fishing rod
            set name of {_x} to "&bNeptune Rod"
            set lore of {_x} to "&7Rarity: &fEPIC", "&8ID: SIM_ROD_04"
            set custom model data of {_x} to 51104
            give {_x} to arg-2
            send "{@prefix}&aNeptune Rod &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_ROD_05":
            set {_x} to fishing rod
            set name of {_x} to "&bCelestial Rod"
            set lore of {_x} to "&7Rarity: &fLEGENDARY", "&8ID: SIM_ROD_05"
            set custom model data of {_x} to 51105
            give {_x} to arg-2
            send "{@prefix}&aCelestial Rod &7diberikan kepada &f%arg-2%&7."
            stop
        send "{@prefix}&cRod ID tidak ditemukan."

command /sbait [<text>] [<player>] [<text>]:
    permission: simbiosa.fishing.admin
    permission message: {@prefix}&cKamu tidak punya permission.
    trigger:
        if arg-1 is not "give":
            send "{@prefix}&7Format: /sbait give <player> <bait_id>"
            stop
        if arg-2 is not set or arg-3 is not set:
            send "{@prefix}&7Format: /sbait give <player> <bait_id>"
            stop
        if arg-3 is "SIM_BAIT_01":
            set {_x} to rabbit hide
            set name of {_x} to "&eWorm Bait"
            set lore of {_x} to "&7Rarity: &fCOMMON", "&8ID: SIM_BAIT_01"
            set custom model data of {_x} to 51201
            give {_x} to arg-2
            send "{@prefix}&aWorm Bait &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_BAIT_02":
            set {_x} to rabbit hide
            set name of {_x} to "&eGrub Bait"
            set lore of {_x} to "&7Rarity: &fUNCOMMON", "&8ID: SIM_BAIT_02"
            set custom model data of {_x} to 51202
            give {_x} to arg-2
            send "{@prefix}&aGrub Bait &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_BAIT_03":
            set {_x} to tropical fish
            set name of {_x} to "&eMinnow Bait"
            set lore of {_x} to "&7Rarity: &fRARE", "&8ID: SIM_BAIT_03"
            set custom model data of {_x} to 51203
            give {_x} to arg-2
            send "{@prefix}&aMinnow Bait &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_BAIT_04":
            set {_x} to glow ink sac
            set name of {_x} to "&eGlow Bait"
            set lore of {_x} to "&7Rarity: &fEPIC", "&8ID: SIM_BAIT_04"
            set custom model data of {_x} to 51204
            give {_x} to arg-2
            send "{@prefix}&aGlow Bait &7diberikan kepada &f%arg-2%&7."
            stop
        if arg-3 is "SIM_BAIT_05":
            set {_x} to gold nugget
            set name of {_x} to "&eGolden Bait"
            set lore of {_x} to "&7Rarity: &fLEGENDARY", "&8ID: SIM_BAIT_05"
            set custom model data of {_x} to 51205
            give {_x} to arg-2
            send "{@prefix}&aGolden Bait &7diberikan kepada &f%arg-2%&7."
            stop
        send "{@prefix}&cBait ID tidak ditemukan."

on tab complete of "/sfish":
    set tab completions for position 1 to "list", "give", "reload"
on tab complete of "/srod":
    set tab completions for position 1 to "give"
on tab complete of "/sbait":
    set tab completions for position 1 to "give"

# IMPORTANT:
# This file is a starter/admin item-give layer, not a complete fishing loot mechanic.
# Resource-pack model dispatch and Geyser item mappings must be configured separately.
# Custom model data ranges used here: fish 51001-51030, rods 51101-51105, bait 51201-51205.
# ToolSkins CMD 50001-50007 and Gacha Keys 50100-50107 are untouched.
